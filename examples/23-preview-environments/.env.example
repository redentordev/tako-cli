# Environment Variables for Tako CLI
# Copy this file to .env and fill in your actual values

# REQUIRED: The production server IP address
SERVER1_HOST=YOUR_PRODUCTION_SERVER_IP

# REQUIRED: The preview server IP address
SERVER2_HOST=YOUR_PREVIEW_SERVER_IP

# REQUIRED: Path to the SSH private key for both servers
SSH_KEY=~/.ssh/id_ed25519

# REQUIRED: Email for Let's Encrypt certificates
LETSENCRYPT_EMAIL=YOUR_EMAIL

# REQUIRED: Database password (previews get their own fresh database)
POSTGRES_PASSWORD=YOUR_DATABASE_PASSWORD
