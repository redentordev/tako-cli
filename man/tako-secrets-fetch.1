.TH "TAKO" "1" "Jun 2026" "Tako CLI" "Tako CLI Manual"

.SH NAME
tako-secrets-fetch - Fetch secrets from an external provider


.SH SYNOPSIS
\fBtako secrets fetch PROVIDER [NAME...] [flags]\fP


.SH DESCRIPTION
Fetch secrets from an external provider and print only redacted values by default.

.PP
Each provider shells out to its official CLI, which must be installed and
authenticated. Run 'tako secrets providers' for details.

.PP
Supported providers:
  aws-ssm              AWS Systems Manager Parameter Store (names, --from prefix, or --path recursive)
  aws-secrets-manager  AWS Secrets Manager (names or --path name prefix; JSON secrets are flattened)
  vault                HashiCorp Vault KV v1/v2 (secret paths or --path recursive; uses VAULT_ADDR/VAULT_TOKEN)
  openbao              OpenBao KV v1/v2 (secret paths or --path recursive; uses BAO_ADDR/BAO_TOKEN)
  1password            1Password (item names with --vault, op:// references, or every item in --vault)
  doppler              Doppler (--project and --provider-env config; all secrets or selected names)
  infisical            Infisical (--project ID, --provider-env slug, optional --path folder)
  gcp-secret-manager   Google Cloud Secret Manager (secret names or --path name prefix; latest version)
  azure-key-vault      Azure Key Vault (--vault with secret names or --path name prefix)
  bitwarden            Bitwarden Secrets Manager (optional --project ID; uses BWS_ACCESS_TOKEN)

.PP
Examples:
  tako secrets import aws-ssm --path /myapp/prod --prefix-strip /myapp/prod
  tako secrets import aws-secrets-manager myapp/prod --prefix-strip myapp/prod
  tako secrets import vault --path secret/myapp/prod --prefix-strip secret/myapp/prod
  tako secrets import 1password Postgres Stripe --vault Production
  tako secrets import doppler --project api --provider-env prd
  tako secrets import infisical --project  --provider-env prod
  tako secrets import gcp-secret-manager --project acme --path myapp-
  tako secrets import azure-key-vault --vault acme-kv --path myapp-
  tako secrets import bitwarden --project 


.SH OPTIONS
\fB--debug-show-values\fP[=false]
	Print plaintext secret values

.PP
\fB--dry-run\fP[=false]
	Preview provider import without writing

.PP
\fB-e\fP, \fB--env\fP=""
	Environment (e.g., production, staging)

.PP
\fB--from\fP=""
	Provider folder/name prefix for explicit names

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for fetch

.PP
\fB--map\fP=[]
	Map provider source to local secret key (SOURCE=DEST)

.PP
\fB--path\fP=""
	Provider path/prefix to import recursively (Infisical: secret folder)

.PP
\fB--prefix-strip\fP=""
	Strip this provider prefix before deriving local secret keys

.PP
\fB--profile\fP=""
	AWS CLI profile (aws-ssm, aws-secrets-manager)

.PP
\fB--project\fP=""
	GCP project, Doppler project, Infisical project ID, or Bitwarden project ID

.PP
\fB--provider-env\fP=""
	Provider-side environment: Doppler config or Infisical environment slug

.PP
\fB--region\fP=""
	AWS region (aws-ssm, aws-secrets-manager)

.PP
\fB--vault\fP=""
	1Password vault or Azure Key Vault name


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config file (default is ./tako.yaml or ./tako.json)

.PP
\fB--events\fP=""
	stream progress events to stdout: ndjson (human output moves to stderr)

.PP
\fB--host-key-mode\fP=""
	SSH host key verification mode: tofu, strict, ask (default: tofu)

.PP
\fB--output\fP="text"
	output format: text or json (json reserves stdout for the final result document)

.PP
\fB--preview\fP=""
	preview environment to use (deploy, ps, logs, exec, history, rollback, config explain); -e then names its base

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	verbose output


.SH SEE ALSO
\fBtako-secrets(1)\fP
