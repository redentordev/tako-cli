.nh
.TH "TAKO" "1" "Jun 2026" "Tako CLI" "Tako CLI Manual"

.SH NAME
tako-secrets-set - Set a secret value


.SH SYNOPSIS
\fBtako secrets set KEY=value | KEY=@FILE | KEY --stdin [flags]\fP


.SH DESCRIPTION
Set a secret value in the .tako/secrets files.

.PP
A value passed as KEY=value is visible to other local users (ps,
/proc//cmdline) while the command runs and may be saved in shell
history. Prefer one of the forms that keep the value off the command line:

.PP
KEY --stdin   read the value from standard input
  KEY=@FILE     read the value from FILE

.PP
One trailing newline is stripped from values read from stdin or a file.
To store a literal value that starts with '@', write it as KEY=@@value.
To import many secrets at once, use 'tako secrets import --format env'.


.SH OPTIONS
\fB-e\fP, \fB--env\fP=""
	Environment (e.g., production, staging)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for set

.PP
\fB--stdin\fP[=false]
	Read the secret value from stdin (one trailing newline is stripped)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	config file (default is ./tako.yaml or ./tako.json)

.PP
\fB--events\fP=""
	stream progress events to stdout: ndjson (human output moves to stderr)

.PP
\fB--host-key-mode\fP=""
	SSH host key verification mode: tofu, strict, ask (default: tofu)

.PP
\fB--output\fP="text"
	output format: text or json (json reserves stdout for the final result document)

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	verbose output


.SH EXAMPLE
.EX
  printf '%s' "$DB_PASSWORD" | tako secrets set DB_PASSWORD --stdin --env production
  tako secrets set TLS_KEY=@./certs/server.key
  op read op://Prod/api/token | tako secrets set API_TOKEN --stdin
.EE


.SH SEE ALSO
\fBtako-secrets(1)\fP
